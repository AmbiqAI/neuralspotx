/**
 * A staged walkthrough: a rail of stages over one terminal frame, played one
 * stage at a time. Every stage is rendered server-side so a reader without
 * JavaScript, and the Markdown rendition, see all of them; the behavior layer
 * only decides which one is showing.
 *
 * Composed from helia-ui parts (Surface, the chip recipe, AsciiTerminal). The
 * package has no walkthrough part yet; the shape here is the proposal for one
 * (see tasks/256-docs-migration/helia-ui-gaps-260.md).
 */
import type { AsciiTerminalLine } from '@ambiqai/helia-ui/astro/AsciiTerminal';
import AsciiTerminal from '@ambiqai/helia-ui/astro/AsciiTerminal';

export interface WalkthroughStage {
  id: string;
  label: string;
  title: string;
  caption: string;
  lines: readonly AsciiTerminalLine[];
}

interface Props {
  /** The stages, in order. */
  stages: readonly WalkthroughStage[];
  /** Accessible name for the whole card. */
  label?: string;
  /** Milliseconds a finished stage stays before the next one starts. */
  dwell?: number;
  /** Milliseconds per typed character in a command line. */
  typingSpeed?: number;
  /** Milliseconds of pause after each line. */
  lineDelay?: number;
}

const {
  stages,
  label = 'From install to running firmware',
  dwell = 5500,
  typingSpeed = 45,
  lineDelay = 650,
} = Astro.props;

/*
 * Same reasoning as AsciiTerminal: the behavior must cost nothing when it is
 * not used, so it ships inline and defines the element once.
 */
const BEHAVIOR = `
(() => {
  if (customElements.get('nsx-journey-walkthrough')) return;
  class NsxJourneyWalkthrough extends HTMLElement {
    connectedCallback() {
      this.cleanup?.();
      const tabs = [...this.querySelectorAll('[data-stage-tab]')];
      const panels = [...this.querySelectorAll('[data-stage-panel]')];
      const captions = [...this.querySelectorAll('[data-stage-caption-text]')];
      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      const controller = new AbortController();
      const signal = controller.signal;
      const typing = Number(this.dataset.typing);
      const delay = Number(this.dataset.lineDelay);
      const dwell = Number(this.dataset.dwell);
      let active = 0, elapsed = 0, last = performance.now(), frame = 0;
      let paused = motion.matches, started = false;
      const timelines = panels.map(panel => {
        let end = 0;
        const lines = [...panel.querySelectorAll('[data-line]')].map(line => {
          const value = line.dataset.text || ' ';
          const duration = line.dataset.kind === 'command' ? value.length * typing : 0;
          const start = end;
          end += duration + delay;
          return { line, text: line.querySelector('[data-line-text]'), value, start, duration };
        });
        return { lines, total: end + dwell };
      });
      const controls = () => {
        this.toggleAttribute('data-paused', paused);
        tabs.forEach((tab, i) => {
          tab.title = i === active ? (paused ? 'Resume walkthrough' : 'Pause walkthrough') : 'Show this step';
        });
      };
      const render = () => {
        const timeline = timelines[active];
        const time = motion.matches ? timeline.total : elapsed;
        timeline.lines.forEach(({line, text, value, start, duration}) => {
          line.dataset.state = time >= start ? 'visible' : 'pending';
          text.textContent = time < start ? '' : duration ? value.slice(0, Math.floor((time - start) / typing)) : value;
          line.dataset.active = String(!paused && time >= start && time < start + duration);
        });
        tabs[active].querySelector('rect').style.strokeDashoffset = String(100 * (1 - Math.min(time / timeline.total, 1)));
      };
      const show = index => {
        active = (index + panels.length) % panels.length;
        elapsed = 0;
        last = performance.now();
        this.dataset.stage = String(active);
        tabs.forEach((tab, i) => {
          tab.setAttribute('aria-selected', String(i === active));
          tab.tabIndex = i === active ? 0 : -1;
          tab.classList.toggle('helia-chip--accent', i === active);
          tab.querySelector('rect').style.strokeDashoffset = '100';
        });
        panels.forEach((panel, i) => {
          panel.dataset.active = String(i === active);
          panel.setAttribute('aria-hidden', String(i !== active));
          panel.querySelector('helia-ascii-terminal').dataset.enhanced = 'true';
        });
        captions.forEach((caption, i) => caption.dataset.active = String(i === active));
        controls();
        render();
      };
      const toggle = () => { paused = !paused; last = performance.now(); controls(); render(); };
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => i === active ? toggle() : show(i), {signal});
        tab.addEventListener('keydown', event => {
          if (!['ArrowRight', 'ArrowLeft'].includes(event.key)) return;
          event.preventDefault();
          show(i + (event.key === 'ArrowRight' ? 1 : -1));
          tabs[active].focus();
        }, {signal});
      });
      motion.addEventListener('change', () => { paused = motion.matches; controls(); render(); }, {signal});
      const observer = new IntersectionObserver(entries => {
        if (entries.some(entry => entry.isIntersecting)) { started = true; last = performance.now(); observer.disconnect(); }
      }, {threshold: .4});
      const tick = time => {
        if (started && !paused && !motion.matches && !document.hidden) {
          elapsed += Math.min(time - last, 100);
          if (elapsed >= timelines[active].total) show(active + 1);
          render();
        }
        last = time;
        frame = requestAnimationFrame(tick);
      };
      show(0);
      observer.observe(this);
      frame = requestAnimationFrame(tick);
      this.cleanup = () => { cancelAnimationFrame(frame); observer.disconnect(); controller.abort(); };
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  customElements.define('nsx-journey-walkthrough', NsxJourneyWalkthrough);
})();
`;

---

<nsx-journey-walkthrough
  class="journey helia-surface not-content"
  role="region"
  aria-label={label}
  style={`--journey-dwell: ${dwell}ms`}
  data-dwell={dwell}
  data-typing={typingSpeed}
  data-line-delay={lineDelay}
  data-stage="0"
>
  <div class="journey__rail" role="tablist" aria-label="Stages">
    {stages.map((stage, i) => (
      <button
        type="button"
        role="tab"
        id={`journey-tab-${stage.id}`}
        aria-controls={`journey-panel-${stage.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class:list={['helia-chip', 'helia-chip--md', 'helia-focus-ring', { 'helia-chip--accent': i === 0 }]}
        data-stage-tab
      >
        <svg class="journey__outline" aria-hidden="true"><rect x="1" y="1" width="calc(100% - 2px)" height="calc(100% - 2px)" rx="15" pathLength="100" /></svg>
        <span class="journey__step">{i + 1}</span>
        {stage.label}
      </button>
    ))}
  </div>
  <div class="journey__captions">
    {stages.map((stage, i) => (
      <p class="journey__caption" data-stage-caption-text data-active={i === 0 ? 'true' : 'false'}>{stage.caption}</p>
    ))}
  </div>
  <div class="journey__stages">
    {stages.map((stage, i) => (
      <div
        class="journey__stage"
        id={`journey-panel-${stage.id}`}
        role="tabpanel"
        aria-labelledby={`journey-tab-${stage.id}`}
        aria-hidden={i === 0 ? 'false' : 'true'}
        data-stage-panel
        data-active={i === 0 ? 'true' : 'false'}
      >
        <AsciiTerminal
          title={stage.title}
          lines={stage.lines}
          animated={false}
          autoplay={false}
          typingSpeed={typingSpeed}
          lineDelay={lineDelay}
        />
      </div>
    ))}
  </div>
  <script is:inline set:html={BEHAVIOR} />
</nsx-journey-walkthrough>

<style>
  /* No helia recipe stacks siblings in one cell; the stages sit on top of
     each other so the card keeps the height of its tallest stage and the page
     never jumps when the active one changes. */
  .journey {
    display: grid;
    min-width: 0;
    overflow: hidden;
    gap: var(--helia-space-4);
    padding: var(--helia-space-5);
  }
  .journey__rail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--helia-space-2);
  }
  .journey__rail [role='tab'] {
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }
  .journey__outline { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
  .journey__outline rect { fill: none; stroke: var(--helia-product-accent, currentColor); stroke-width: 2; stroke-dasharray: 100; stroke-dashoffset: 100; }
  [aria-selected='false'] .journey__outline { visibility: hidden; }
  .journey__step {
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
    margin-inline-end: var(--helia-space-1);
  }

  /* Captions stack in one cell for the same reason the stages do: the card
     must not grow and shrink as the active caption changes length. */
  .journey__captions {
    display: grid;
    flex: 1;
    min-width: 0;
  }
  .journey__caption[data-active='false'] {
    visibility: hidden;
  }

  /* Grid children default to min-width auto, which lets a wide transcript
     push the frame past the card edge on a phone; zero lets the terminal's
     own horizontal scroll take over instead. */
  .journey__stages {
    display: grid;
    min-width: 0;
  }
  .journey__stage {
    grid-area: 1 / 1;
    min-width: 0;
  }
  .journey__stage[data-active='false'] {
    visibility: hidden;
    pointer-events: none;
  }
  .journey__stage[data-active='true'] {
    visibility: visible;
  }
  .journey__caption {
    grid-area: 1 / 1;
    margin: 0;
    color: var(--helia-ink-secondary);
  }
</style>
