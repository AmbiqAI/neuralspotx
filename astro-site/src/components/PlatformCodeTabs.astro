import CodeTabs from '@ambiqai/helia-ui/astro/CodeTabs';
import type { ComponentProps } from 'astro/types';
type Props = ComponentProps<typeof CodeTabs>;
---
<nsx-platform-tabs><CodeTabs {...Astro.props} /></nsx-platform-tabs>
<script>
  class PlatformTabs extends HTMLElement {
    observer?: MutationObserver;
    connectedCallback() {
      this.observer = new MutationObserver(() => {
        const selected = this.querySelector('[role="tab"][aria-selected="true"]')?.textContent?.trim();
        if (!selected) return;
        document.querySelectorAll('nsx-platform-tabs').forEach((group) => {
          if (group === this) return;
          const tab = Array.from(group.querySelectorAll<HTMLButtonElement>('[role="tab"]'))
            .find((item) => item.textContent?.trim() === selected);
          if (tab?.getAttribute('aria-selected') === 'false') tab.click();
        });
      });
      this.observer.observe(this, { subtree: true, attributes: true, attributeFilter: ['aria-selected'] });
    }
    disconnectedCallback() { this.observer?.disconnect(); }
  }
  if (!customElements.get('nsx-platform-tabs')) customElements.define('nsx-platform-tabs', PlatformTabs);
</script>
<style>nsx-platform-tabs { display: block; }</style>
