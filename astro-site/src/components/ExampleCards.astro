/*
 * One tier of the example grid on Home, from the front matter
 * scripts/build-examples.mjs already reads. A card and the page it links to
 * therefore carry the same title and summary, and adding an example under
 * examples/ puts it here without an edit.
 *
 * Same reason as HomeStats for being a component rather than an expression in
 * the page: the Markdown rendition is derived from MDX source, so a `.map` in
 * the page would reach an agent as source text (AmbiqAI/helia-ui#143). The
 * link list under the grid is what that reader gets, and
 * scripts/check-output.mjs fails the build if it omits an example.
 */
import CardGrid from '@ambiqai/helia-ui/astro/CardGrid';
import LinkCard from '@ambiqai/helia-ui/astro/LinkCard';
import data from '../data/examples.json';

interface Props {
  tier: string;
}

const { tier } = Astro.props;
const label = data.tierLabels[tier as keyof typeof data.tierLabels];
if (!label) throw new Error(`ExampleCards: unknown tier '${tier}'`);

const examples = data.examples.filter((example) => example.tier === tier);
if (!examples.length) throw new Error(`ExampleCards: no examples in tier '${tier}'`);
---

<CardGrid columns={3} density="compact" equalize>
  {
    examples.map((example) => (
      <LinkCard
        href={example.href}
        title={example.title}
        titleAs="h3"
        eyebrow={label}
        meta={`nsx build ${example.name}`}
        lift
      >
        {example.summary}
      </LinkCard>
    ))
  }
</CardGrid>
