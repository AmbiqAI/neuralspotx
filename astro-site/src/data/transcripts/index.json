{
  "_note": "Abbreviated setup/build captures; flash stages and view output are illustrative examples, not a hardware capture.",
  "stages": [
    {
      "id": "install",
      "label": "Install",
      "title": "Install the CLI",
      "command": "uv tool install neuralspotx",
      "caption": "Install the NSX CLI after setting up the host tools and compiler.",
      "lines": [
        {
          "kind": "command",
          "text": "uv tool install neuralspotx"
        },
        {
          "kind": "success",
          "text": "Installed 1 executable: nsx"
        }
      ]
    },
    {
      "id": "check",
      "label": "Check",
      "title": "Check the environment",
      "command": "nsx doctor",
      "caption": "nsx doctor names every host tool it needs and what a missing one would cost you.",
      "lines": [
        {
          "kind": "command",
          "text": "nsx doctor"
        },
        {
          "kind": "success",
          "text": "[OK] cmake"
        },
        {
          "kind": "success",
          "text": "[OK] ninja"
        },
        {
          "kind": "success",
          "text": "[OK] arm-none-eabi-gcc"
        },
        {
          "kind": "success",
          "text": "[OK] SEGGER J-Link"
        }
      ]
    },
    {
      "id": "create",
      "label": "Create",
      "title": "Create an app for a board",
      "command": "nsx create-app",
      "caption": "A complete app directory for a real board: nsx.yml, CMakeLists.txt, sources and the starter modules.",
      "lines": [
        {
          "kind": "command",
          "text": "nsx create-app hello_ap510 --board apollo510_evb"
        },
        {
          "kind": "success",
          "text": "Created app 'hello_ap510' at: /home/you/hello_ap510"
        },
        {
          "kind": "output",
          "text": "Next steps:"
        },
        {
          "kind": "output",
          "text": "  1) cd /home/you/hello_ap510"
        },
        {
          "kind": "output",
          "text": "  2) Run `nsx configure --app-dir .`"
        }
      ]
    },
    {
      "id": "build",
      "label": "Build",
      "title": "Configure and build",
      "command": "nsx build",
      "caption": "Modules resolve and lock, CMake generates, Ninja builds. The result is an ordinary project you own.",
      "lines": [
        {
          "kind": "command",
          "text": "cd hello_ap510 && nsx configure"
        },
        {
          "kind": "success",
          "text": "Configured app at: /home/you/hello_ap510"
        },
        {
          "kind": "command",
          "text": "nsx build"
        },
        {
          "kind": "muted",
          "text": "[..] (24 compile, archive and link steps)"
        },
        {
          "kind": "output",
          "text": "   text    data     bss     dec     hex filename"
        },
        {
          "kind": "output",
          "text": "  19080     592  507312  526984   80a88 hello_ap510"
        }
      ]
    },
    {
      "id": "flash",
      "label": "Flash",
      "title": "Flash it over J-Link",
      "command": "nsx flash",
      "caption": "nsx flash builds if needed, then programs the board over SWD through the SEGGER tools nsx doctor checked.",
      "lines": [
        {
          "kind": "command",
          "text": "nsx flash"
        },
        {
          "kind": "muted",
          "text": "[Connect to J-Link; program and verify firmware]"
        },
        {
          "kind": "muted",
          "text": "[Reset target and start application]"
        }
      ]
    },
    {
      "id": "view",
      "label": "View",
      "title": "Watch it run",
      "command": "nsx view",
      "caption": "nsx view opens the SWO viewer and streams the firmware's output back to your terminal.",
      "lines": [
        {
          "kind": "command",
          "text": "nsx view"
        },
        {
          "kind": "output",
          "text": "nsx hello from generated app"
        },
        {
          "kind": "output",
          "text": "nsx hello from generated app"
        }
      ]
    }
  ]
}
