{
  "name": "neuralspotx-site",
  "description": "Astro Starlight documentation for neuralSPOT-X",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "prepare:docs": "node scripts/build-info.mjs",
    "predev": "npm run prepare:docs",
    "dev": "astro dev",
    "prebuild": "npm run prepare:docs",
    "build": "astro build",
    "preview": "astro preview",
    "precheck": "npm run prepare:docs",
    "check": "astro check",
    "validate": "node scripts/check-output.mjs && helia-ui-check-spdx --root .",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('.astro',{recursive:true,force:true})\"",
    "smoke:pyref": "node scripts/smoke-pyref.mjs"
  },
  "dependencies": {
    "@ambiqai/helia-ui": "github:AmbiqAI/helia-ui#v0.1.0-alpha.14",
    "@astrojs/react": "^6.0.2",
    "@astrojs/starlight": "^0.41.5",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.0.2",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9.3"
  }
}
