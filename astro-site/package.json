{
  "name": "neuralspotx-site",
  "description": "Astro Starlight documentation for neuralSPOT-X",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "prepare:docs": "node scripts/build-info.mjs && node scripts/build-reference.mjs && node scripts/build-modules.mjs && node scripts/build-examples.mjs",
    "predev": "npm run prepare:docs",
    "dev": "astro dev",
    "prebuild": "npm run prepare:docs",
    "build": "astro build",
    "preview": "astro preview",
    "precheck": "npm run prepare:docs",
    "check": "astro check",
    "validate": "node scripts/check-output.mjs && node scripts/check-reference-output.mjs && node scripts/check-modules-output.mjs && helia-ui-check-spdx --root . && helia-ui-check-spelling --root .",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('.astro',{recursive:true,force:true})\"",
    "build:reference": "node scripts/build-reference.mjs",
    "check:reference": "node scripts/check-reference-output.mjs",
    "build:modules": "node scripts/build-modules.mjs",
    "build:examples": "node scripts/build-examples.mjs",
    "check:modules": "node scripts/check-modules-output.mjs",
    "test:modules": "node scripts/test-modules-escaping.mjs"
  },
  "dependencies": {
    "@ambiqai/helia-ui": "github:AmbiqAI/helia-ui#266f614958eae8ace4ada151c9d0bed0677203d1",
    "@astrojs/react": "^6.0.2",
    "@astrojs/starlight": "^0.41.5",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.0.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9.3"
  }
}
