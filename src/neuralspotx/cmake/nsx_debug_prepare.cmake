cmake_minimum_required(VERSION 3.31)
include("${CMAKE_CURRENT_LIST_DIR}/debug/collect.cmake")
nsx_debug_path("${NSX_DEBUG_BUILD_DIR}")
set(build "${NSX_DEBUG_BUILD_DIR}")
file(REMOVE "${build}/nsx-debug/context.json")
if(NOT EXISTS "${build}/CMakeCache.txt")
    nsx_debug_fail("configure the opted-in build first")
endif()
file(STRINGS "${build}/CMakeCache.txt" source_line REGEX "^CMAKE_HOME_DIRECTORY:INTERNAL=")
string(REGEX REPLACE "^CMAKE_HOME_DIRECTORY:INTERNAL=" "" source "${source_line}")
nsx_debug_path("${source}")
file(STRINGS "${build}/CMakeCache.txt" enabled REGEX "^NSX_DEBUG_CONTEXT:BOOL=ON$")
if(NOT enabled)
    nsx_debug_fail("configure with -DNSX_DEBUG_CONTEXT=ON -DNSX_DEBUG_INPUT_CONTRACT=1 first")
endif()
file(MAKE_DIRECTORY "${build}/.cmake/api/v1/query")
file(WRITE "${build}/.cmake/api/v1/query/cmakeFiles-v1" "")
foreach(pass RANGE 0 2)
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source}" -B "${build}" RESULT_VARIABLE result)
    if(NOT result STREQUAL "0")
        nsx_debug_fail("configure failed during preparation")
    endif()
    if(pass GREATER 0)
        nsx_debug_collect("${build}" candidate)
        if(pass EQUAL 1)
            set(expected "${candidate}")
        elseif(NOT candidate STREQUAL expected)
            nsx_debug_fail("evaluated snapshots disagree")
        endif()
    endif()
endforeach()
file(WRITE "${build}/nsx-debug/context.tmp" "${candidate}\n")
file(RENAME "${build}/nsx-debug/context.tmp" "${build}/nsx-debug/context.json")
