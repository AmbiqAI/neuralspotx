cmake_minimum_required(VERSION 3.31)
include("${CMAKE_CURRENT_LIST_DIR}/debug/validate.cmake")
set(build "${NSX_DEBUG_BUILD_DIR}")
set(dest "${NSX_DEBUG_CAPTURE_DIR}")
nsx_debug_path("${dest}")
file(REAL_PATH "${dest}" resolved)
foreach(root "${build}" "${NSX_DEBUG_SOURCE_DIR}")
    file(REAL_PATH "${root}" root)
    cmake_path(IS_PREFIX root "${resolved}" NORMALIZE contained)
    if(contained)
        nsx_debug_fail("capture directory must be outside app and build")
    endif()
endforeach()
if(NOT IS_DIRECTORY "${dest}")
    nsx_debug_fail("caller must supply a private empty capture directory")
endif()
file(GLOB existing "${dest}/*" "${dest}/.*")
if(existing)
    nsx_debug_fail("capture directory must be empty")
endif()
if(NOT NSX_DEBUG_OPERATION MATCHES "^(flash|reset|swo|rtt)$")
    nsx_debug_fail("unsupported capture operation")
endif()
set(context_path "${build}/nsx-debug/context.json")
file(READ "${context_path}" context)
nsx_debug_validate("${context}" "${build}" "${NSX_DEBUG_SOURCE_DIR}" "${NSX_DEBUG_BOARD}")
string(JSON record GET "${context}" targets "${NSX_DEBUG_TARGET}")
string(JSON reason GET "${record}" capabilities "${NSX_DEBUG_OPERATION}")
if(NOT reason STREQUAL "")
    nsx_debug_fail("operation unavailable: ${reason}")
endif()
set(copies "[]")
if(NSX_DEBUG_OPERATION STREQUAL flash)
    set(kinds bin)
elseif(NSX_DEBUG_OPERATION STREQUAL rtt)
    set(kinds elf)
else()
    set(kinds "")
endif()
foreach(kind IN LISTS kinds)
    string(JSON source GET "${record}" ${kind})
    nsx_debug_output("${source}" "${build}")
    nsx_debug_hash("${source}" before)
    set(output "${dest}/firmware.${kind}")
    file(COPY_FILE "${source}" "${output}")
    nsx_debug_hash("${output}" copied)
    nsx_debug_hash("${source}" after)
    if(NOT before STREQUAL copied OR NOT before STREQUAL after)
        nsx_debug_fail("artifact changed during capture")
    endif()
    nsx_debug_quote("${source}" quoted)
    string(JSON entry SET "{}" path "${quoted}")
    string(JSON entry SET "${entry}" sha256 "\"${before}\"")
    string(JSON copies SET "${copies}" 0 "${entry}")
endforeach()
if(NSX_DEBUG_OPERATION STREQUAL flash)
    string(JSON NSX_SEGGER_PF_ADDR GET "${record}" load_address)
    string(JSON helper_root GET "${context}" helper_root)
    file(READ "${helper_root}/segger/templates/flash_cmds.jlink.in" template)
    string(JSON NSX_JLINK_BIN_FILE GET "${record}" bin)
    string(CONFIGURE "${template}" expected_direct @ONLY)
    string(JSON recipe GET "${record}" flash_recipe)
    file(READ "${recipe}" actual_direct)
    if(NOT expected_direct STREQUAL actual_direct)
        nsx_debug_fail("flash template requires settings outside the captured contract")
    endif()
    set(NSX_JLINK_BIN_FILE "${dest}/firmware.bin")
    string(CONFIGURE "${template}" rendered @ONLY)
    file(WRITE "${dest}/flash_cmds.jlink" "${rendered}")
elseif(NSX_DEBUG_OPERATION STREQUAL swo)
    string(JSON recipe GET "${record}" reset_recipe)
    nsx_debug_output("${recipe}" "${build}")
    file(COPY_FILE "${recipe}" "${dest}/reset_cmds.jlink")
    nsx_debug_hash("${recipe}" before)
    nsx_debug_hash("${dest}/reset_cmds.jlink" copied)
    if(NOT before STREQUAL copied)
        nsx_debug_fail("reset recipe changed during capture")
    endif()
endif()
# Source/context validation brackets capture. Stable writers remain a prerequisite.
nsx_debug_validate("${context}" "${build}" "${NSX_DEBUG_SOURCE_DIR}" "${NSX_DEBUG_BOARD}")
file(READ "${context_path}" current)
if(NOT current STREQUAL context)
    nsx_debug_fail("published context changed during capture")
endif()
if(kinds)
    nsx_debug_hash("${source}" final)
    if(NOT final STREQUAL after)
        nsx_debug_fail("artifact changed before capture completed")
    endif()
endif()
file(WRITE "${dest}/context.json" "${context}")
file(WRITE "${dest}/artifacts.json" "${copies}\n")
