include("${CMAKE_CURRENT_LIST_DIR}/common.cmake")
function(nsx_debug_collect build out)
    file(READ "${build}/nsx-debug/raw/meta.json" meta)
    string(JSON source GET "${meta}" source)
    string(JSON helper_root GET "${meta}" helper_root)
    set(ctx "${meta}")
    string(JSON ctx REMOVE "${ctx}" target_names)
    string(JSON ctx REMOVE "${ctx}" declared_inputs)
    foreach(key schema_version helper_protocol input_contract)
        string(JSON ctx SET "${ctx}" ${key} 1)
    endforeach()
    file(GLOB indexes "${build}/.cmake/api/v1/reply/index-*.json")
    if(NOT indexes)
        nsx_debug_fail("no file-API reply")
    endif()
    list(SORT indexes)
    list(GET indexes -1 index)
    file(READ "${index}" index_json)
    string(JSON filename GET "${index_json}" reply cmakeFiles-v1 jsonFile)
    file(READ "${build}/.cmake/api/v1/reply/${filename}" files)
    string(JSON minor GET "${files}" version minor)
    if(minor LESS 1)
        nsx_debug_fail("file-API cmakeFiles 1.1 required")
    endif()
    set(paths "${build}/CMakeCache.txt" "${build}/nsx-debug/protocol" "${build}/nsx-debug/raw/meta.json")
    string(JSON n LENGTH "${files}" inputs)
    if(n GREATER 0)
        math(EXPR last "${n}-1")
        foreach(i RANGE 0 ${last})
            string(JSON path GET "${files}" inputs ${i} path)
            if(NOT IS_ABSOLUTE "${path}")
                set(path "${source}/${path}")
            endif()
            list(APPEND paths "${path}")
        endforeach()
    endif()
    string(JSON n LENGTH "${meta}" declared_inputs)
    if(n GREATER 0)
        math(EXPR last "${n}-1")
        foreach(i RANGE 0 ${last})
            string(JSON path GET "${meta}" declared_inputs ${i} path)
            string(JSON consumed GET "${meta}" declared_inputs ${i} sha256)
            nsx_debug_hash("${path}" current)
            if(NOT current STREQUAL consumed)
                nsx_debug_fail("declared input changed after read: ${path}")
            endif()
            list(APPEND paths "${path}")
        endforeach()
    endif()
    set(targets "{}")
    string(JSON n LENGTH "${meta}" target_names)
    math(EXPR last "${n}-1")
    foreach(i RANGE 0 ${last})
        string(JSON target GET "${meta}" target_names ${i})
        set(raw "${build}/nsx-debug/raw/${target}.json")
        file(READ "${raw}" record)
        list(APPEND paths "${raw}")
        foreach(kind elf bin)
            set(pointer "${build}/nsx-debug/raw/${target}.${kind}.path")
            file(READ "${pointer}" path)
            string(REGEX REPLACE "\n$" "" path "${path}")
            nsx_debug_output("${path}" "${build}")
            nsx_debug_quote("${path}" quoted)
            string(JSON record SET "${record}" ${kind} "${quoted}")
            list(APPEND paths "${pointer}")
        endforeach()
        string(JSON reason GET "${record}" capabilities flash)
        if(reason STREQUAL "")
            foreach(kind flash reset)
                string(JSON path GET "${record}" ${kind}_recipe)
                nsx_debug_output("${path}" "${build}")
                list(APPEND paths "${path}")
                string(JSON template GET "${record}" ${kind}_template)
                list(APPEND paths "${template}")
            endforeach()
            foreach(key speed_khz cpu_hz trace_hz)
                string(JSON value GET "${record}" ${key})
                if(NOT value MATCHES "^[1-9][0-9]*$")
                    nsx_debug_fail("invalid ${key} for ${target}")
                endif()
            endforeach()
            string(JSON address GET "${record}" load_address)
            if(NOT address MATCHES "^(0[xX][0-9a-fA-F]+|[0-9]+)$")
                nsx_debug_fail("invalid load address for ${target}")
            endif()
        endif()
        string(JSON serial GET "${record}" configured_serial)
        if(NOT serial STREQUAL "" AND NOT serial MATCHES "^[0-9]*[1-9][0-9]*$")
            nsx_debug_fail("invalid configured serial for ${target}")
        endif()
        string(JSON targets SET "${targets}" "${target}" "${record}")
    endforeach()
    string(JSON ctx SET "${ctx}" targets "${targets}")
    # Include the scripts used only in script mode, not present in configure's file API.
    file(GLOB scripts "${helper_root}/debug/*.cmake" "${helper_root}/nsx_debug_*.cmake" "${helper_root}/segger/templates/*.in")
    list(APPEND paths ${scripts})
    list(REMOVE_DUPLICATES paths)
    list(SORT paths)
    set(inputs "[]")
    set(i 0)
    foreach(path IN LISTS paths)
        nsx_debug_hash("${path}" hash)
        nsx_debug_quote("${path}" quoted)
        string(JSON entry SET "{}" path "${quoted}")
        string(JSON entry SET "${entry}" sha256 "\"${hash}\"")
        string(JSON inputs SET "${inputs}" ${i} "${entry}")
        math(EXPR i "${i}+1")
    endforeach()
    string(JSON ctx SET "${ctx}" inputs "${inputs}")
    string(JSON n ERROR_VARIABLE absent LENGTH "${files}" globsDependent)
    set(globs "[]")
    if(NOT absent AND n GREATER 0)
        math(EXPR last "${n}-1")
        foreach(i RANGE 0 ${last})
            string(JSON record GET "${files}" globsDependent ${i})
            nsx_debug_glob("${record}" members)
            # Check observed membership against what configure actually evaluated.
            string(JSON count LENGTH "${record}" paths)
            string(JSON observed LENGTH "${members}")
            if(NOT count EQUAL observed)
                nsx_debug_fail("glob membership changed after evaluation")
            endif()
            if(count GREATER 0)
                math(EXPR end "${count}-1")
                foreach(j RANGE 0 ${end})
                    string(JSON expected GET "${record}" paths ${j})
                    string(JSON actual GET "${members}" ${j} path)
                    if(NOT expected STREQUAL actual)
                        nsx_debug_fail("glob membership changed after evaluation")
                    endif()
                endforeach()
            endif()
            string(JSON record REMOVE "${record}" paths)
            string(JSON record SET "${record}" members "${members}")
            string(JSON globs SET "${globs}" ${i} "${record}")
        endforeach()
    endif()
    string(JSON ctx SET "${ctx}" globs "${globs}")
    set(${out} "${ctx}" PARENT_SCOPE)
endfunction()
