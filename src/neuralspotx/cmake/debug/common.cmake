include_guard(GLOBAL)
# Normalize caller-supplied Windows separators before comparing CMake identities.
foreach(var NSX_DEBUG_BUILD_DIR NSX_DEBUG_SOURCE_DIR NSX_DEBUG_CAPTURE_DIR)
    if(DEFINED ${var})
        cmake_path(CONVERT "${${var}}" TO_CMAKE_PATH_LIST ${var} NORMALIZE)
    endif()
endforeach()

function(nsx_debug_fail reason)
    message(FATAL_ERROR "NSX debug context: ${reason}. Stop concurrent edits/builds and rerun explicit debug preparation; upgrade helpers/tool if unsupported.")
endfunction()

function(nsx_debug_quote value out)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${out} "\"${value}\"" PARENT_SCOPE)
endfunction()

# CMake lists and Commander cannot represent all filesystem names safely.
function(nsx_debug_path path)
    if(NOT IS_ABSOLUTE "${path}" OR "${path}" MATCHES "[;\n\r\t\"<>|]" OR "${path}" MATCHES "\\$<")
        nsx_debug_fail("unsupported absolute path '${path}'")
    endif()
endfunction()

function(nsx_debug_output path build)
    nsx_debug_path("${path}")
    set(ancestor "${path}")
    set(suffix "")
    while(NOT EXISTS "${ancestor}")
        cmake_path(GET ancestor FILENAME name)
        set(suffix "/${name}${suffix}")
        cmake_path(GET ancestor PARENT_PATH ancestor)
    endwhile()
    file(REAL_PATH "${ancestor}" resolved)
    string(APPEND resolved "${suffix}")
    file(REAL_PATH "${build}" root)
    cmake_path(IS_PREFIX root "${resolved}" NORMALIZE contained)
    if(NOT contained OR resolved STREQUAL root)
        nsx_debug_fail("output escapes build directory: ${path}")
    endif()
endfunction()

function(nsx_debug_hash path out)
    nsx_debug_path("${path}")
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
        nsx_debug_fail("missing or unsupported file ${path}")
    endif()
    file(SHA256 "${path}" hash)
    set(${out} "${hash}" PARENT_SCOPE)
endfunction()

# Return canonical membership including entry type; do not hash directory contents.
function(nsx_debug_glob record out)
    string(JSON expr GET "${record}" expression)
    nsx_debug_path("${expr}")
    foreach(flag recurse followSymlinks relative)
        string(JSON value ERROR_VARIABLE absent GET "${record}" ${flag})
        if(NOT absent AND value)
            nsx_debug_fail("unsupported glob option ${flag}")
        endif()
    endforeach()
    string(JSON dirs ERROR_VARIABLE absent GET "${record}" listDirectories)
    if(absent)
        set(dirs false)
    endif()
    file(GLOB members LIST_DIRECTORIES ${dirs} "${expr}")
    set(entries "[]")
    set(index 0)
    foreach(path IN LISTS members)
        nsx_debug_path("${path}")
        if(IS_SYMLINK "${path}")
            nsx_debug_fail("symlink glob member ${path}")
        elseif(IS_DIRECTORY "${path}")
            set(kind directory)
        else()
            set(kind file)
        endif()
        nsx_debug_quote("${path}" quoted)
        string(JSON entry SET "{}" path "${quoted}")
        string(JSON entry SET "${entry}" kind "\"${kind}\"")
        string(JSON entries SET "${entries}" ${index} "${entry}")
        math(EXPR index "${index}+1")
    endforeach()
    set(${out} "${entries}" PARENT_SCOPE)
endfunction()
