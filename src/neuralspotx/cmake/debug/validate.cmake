include("${CMAKE_CURRENT_LIST_DIR}/collect.cmake")
function(nsx_debug_stale reason)
    message(FATAL_ERROR "NSX_DEBUG_STALE: ${reason}. Run explicit debug preparation.")
endfunction()

function(nsx_debug_validate context build source board)
    foreach(pair schema_version:1 helper_protocol:1 input_contract:1)
        string(REPLACE ":" ";" parts "${pair}")
        list(GET parts 0 key)
        list(GET parts 1 expected)
        string(JSON actual GET "${context}" ${key})
        if(NOT actual STREQUAL expected)
            nsx_debug_fail("unsupported ${key}")
        endif()
    endforeach()
    foreach(key build source board)
        string(JSON actual GET "${context}" ${key})
        if(NOT actual STREQUAL "${${key}}")
            nsx_debug_fail("${key} identity mismatch")
        endif()
    endforeach()
    string(JSON n LENGTH "${context}" inputs)
    if(n LESS 1)
        nsx_debug_fail("missing input fingerprints")
    endif()
    math(EXPR last "${n}-1")
    foreach(i RANGE 0 ${last})
        string(JSON path GET "${context}" inputs ${i} path)
        string(JSON expected GET "${context}" inputs ${i} sha256)
        if(NOT EXISTS "${path}")
            nsx_debug_stale("missing input ${path}")
        endif()
        nsx_debug_hash("${path}" actual)
        if(NOT actual STREQUAL expected)
            nsx_debug_stale("stale input ${path}")
        endif()
    endforeach()
    string(JSON n LENGTH "${context}" globs)
    if(n GREATER 0)
        math(EXPR last "${n}-1")
        foreach(i RANGE 0 ${last})
            string(JSON record GET "${context}" globs ${i})
            string(JSON expected GET "${record}" members)
            nsx_debug_glob("${record}" actual)
            if(NOT actual STREQUAL expected)
                nsx_debug_stale("stale glob membership or type")
            endif()
        endforeach()
    endif()
    # Bind settings/recipe paths and complete input coverage to the evaluated
    # generation, not merely whichever fingerprint subset a JSON file contains.
    nsx_debug_collect("${build}" evaluated)
    string(JSON canonical GET "${context}")
    if(NOT canonical STREQUAL evaluated)
        nsx_debug_fail("context does not match evaluated generation")
    endif()
endfunction()
