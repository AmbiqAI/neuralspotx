include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/debug/common.cmake")
option(NSX_DEBUG_CONTEXT "Opt in to experimental configured debug handoff" OFF)
# Invalidate even when a previously opted-in build disables the feature.
file(REMOVE "${CMAKE_BINARY_DIR}/nsx-debug/context.json")
if(NSX_DEBUG_CONTEXT)
    nsx_debug_path("${CMAKE_SOURCE_DIR}")
    nsx_debug_path("${CMAKE_BINARY_DIR}")
    nsx_debug_path("${CMAKE_CURRENT_LIST_DIR}")
    if(CMAKE_VERSION VERSION_LESS 3.31 OR NOT CMAKE_GENERATOR STREQUAL "Ninja")
        nsx_debug_fail("handoff requires CMake >=3.31 and single-configuration Ninja")
    endif()
    if(NOT NSX_DEBUG_INPUT_CONTRACT STREQUAL "1")
        nsx_debug_fail("set NSX_DEBUG_INPUT_CONTRACT=1 only after declaring external setting inputs")
    endif()
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/nsx-debug/raw")
    file(WRITE "${CMAKE_BINARY_DIR}/nsx-debug/protocol" "1\n")
    set_property(GLOBAL PROPERTY NSX_DEBUG_DECLARED "[]")
    cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _nsx_debug_finalize)
endif()

function(nsx_debug_read_text)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "PATH;OUT" "")
    if(arg_UNPARSED_ARGUMENTS OR NOT arg_OUT OR NOT arg_PATH)
        nsx_debug_fail("nsx_debug_read_text requires PATH and OUT")
    endif()
    nsx_debug_path("${arg_PATH}")
    nsx_debug_hash("${arg_PATH}" before)
    file(READ "${arg_PATH}" value)
    string(SHA256 consumed "${value}")
    if(NOT consumed STREQUAL before)
        nsx_debug_fail("input changed while read: ${arg_PATH}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${arg_PATH}")
    if(NSX_DEBUG_CONTEXT)
        get_property(declared GLOBAL PROPERTY NSX_DEBUG_DECLARED)
        nsx_debug_quote("${arg_PATH}" qp)
        string(JSON entry SET "{}" path "${qp}")
        string(JSON entry SET "${entry}" sha256 "\"${consumed}\"")
        string(JSON n LENGTH "${declared}")
        string(JSON declared SET "${declared}" ${n} "${entry}")
        set_property(GLOBAL PROPERTY NSX_DEBUG_DECLARED "${declared}")
    endif()
    set(${arg_OUT} "${value}" PARENT_SCOPE)
endfunction()

function(nsx_debug_set_primary_target target)
    if(NOT NSX_DEBUG_CONTEXT)
        return()
    endif()
    get_property(previous GLOBAL PROPERTY NSX_DEBUG_PRIMARY)
    if(NOT "${previous}" STREQUAL "" AND NOT "${previous}" STREQUAL "${target}")
        nsx_debug_fail("conflicting primary targets ${previous} and ${target}")
    endif()
    set_property(GLOBAL PROPERTY NSX_DEBUG_PRIMARY "${target}")
endfunction()

function(_nsx_debug_register target)
    if(NOT NSX_DEBUG_CONTEXT)
        return()
    endif()
    get_target_property(kind "${target}" TYPE)
    if(NOT kind STREQUAL "EXECUTABLE")
        nsx_debug_fail("opt-in context requires executable targets")
    endif()
    if(NOT target MATCHES "^[A-Za-z0-9_.+-]+$")
        nsx_debug_fail("unsupported target name ${target}")
    endif()
    get_property(targets GLOBAL PROPERTY NSX_DEBUG_TARGETS)
    if(target IN_LIST targets)
        nsx_debug_fail("duplicate target ${target}")
    endif()
    set_property(GLOBAL APPEND PROPERTY NSX_DEBUG_TARGETS "${target}")
    set(record "{}")
    foreach(pair device:NSX_SEGGER_DEVICE speed_khz:NSX_SEGGER_IF_SPEED load_address:NSX_SEGGER_PF_ADDR cpu_hz:NSX_SEGGER_CPUFREQ trace_hz:NSX_SEGGER_SWOFREQ configured_serial:NSX_JLINK_SERIAL)
        string(REPLACE ":" ";" parts "${pair}")
        list(GET parts 0 key)
        list(GET parts 1 var)
        nsx_debug_quote("${${var}}" value)
        string(JSON record SET "${record}" "${key}" "${value}")
    endforeach()
    string(JSON record SET "${record}" backend "\"jlink\"")
    string(JSON record SET "${record}" interface "\"SWD\"")
    string(STRIP "${NSX_SEGGER_DEVICE}" stripped_device)
    set(capabilities "{}")
    foreach(operation flash reset swo rtt)
        set(reason "")
        if(operation STREQUAL reset OR operation STREQUAL rtt)
            if(stripped_device STREQUAL "" OR NOT NSX_SEGGER_IF_SPEED MATCHES "^[1-9][0-9]*$")
                set(reason "Missing verified device or connection speed")
            endif()
        elseif(NOT NSX_SEGGER_CONFIG_OK)
            # Preserve current generated flash/SWO recipe guards.
            set(reason "Missing verified board debug settings")
        endif()
        nsx_debug_quote("${reason}" qr)
        string(JSON capabilities SET "${capabilities}" ${operation} "${qr}")
    endforeach()
    string(JSON record SET "${record}" capabilities "${capabilities}")
    foreach(kind flash reset)
        nsx_debug_quote("${jlink_dir}/${kind}_cmds.jlink" qr)
        string(JSON record SET "${record}" "${kind}_recipe" "${qr}")
        nsx_debug_quote("${NSX_CMAKE_DIR}/segger/templates/${kind}_cmds.jlink.in" qr)
        string(JSON record SET "${record}" "${kind}_template" "${qr}")
    endforeach()
    file(WRITE "${CMAKE_BINARY_DIR}/nsx-debug/raw/${target}.json" "${record}\n")
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/nsx-debug/raw/${target}.elf.path" CONTENT "$<TARGET_FILE:${target}>\n")
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/nsx-debug/raw/${target}.bin.path" CONTENT "$<TARGET_FILE_DIR:${target}>/${target}.bin\n")
endfunction()

function(_nsx_debug_finalize)
    get_property(primary GLOBAL PROPERTY NSX_DEBUG_PRIMARY)
    get_property(targets GLOBAL PROPERTY NSX_DEBUG_TARGETS)
    if("${primary}" STREQUAL "" OR NOT primary IN_LIST targets)
        nsx_debug_fail("declare exactly one registered primary using nsx_debug_set_primary_target")
    endif()
    get_property(declared GLOBAL PROPERTY NSX_DEBUG_DECLARED)
    set(meta "{}")
    foreach(key source build board configuration primary_target helper_root)
        if(key STREQUAL source)
            set(value "${CMAKE_SOURCE_DIR}")
        elseif(key STREQUAL build)
            set(value "${CMAKE_BINARY_DIR}")
        elseif(key STREQUAL board)
            set(value "${NSX_BOARD}")
        elseif(key STREQUAL configuration)
            set(value "${CMAKE_BUILD_TYPE}")
        elseif(key STREQUAL helper_root)
            set(value "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
        else()
            set(value "${primary}")
        endif()
        nsx_debug_quote("${value}" quoted)
        string(JSON meta SET "${meta}" "${key}" "${quoted}")
    endforeach()
    string(JSON meta SET "${meta}" declared_inputs "${declared}")
    set(names "[]")
    set(i 0)
    list(SORT targets)
    foreach(target IN LISTS targets)
        string(JSON names SET "${names}" ${i} "\"${target}\"")
        math(EXPR i "${i}+1")
    endforeach()
    string(JSON meta SET "${meta}" target_names "${names}")
    file(WRITE "${CMAKE_BINARY_DIR}/nsx-debug/raw/meta.json" "${meta}\n")
endfunction()
