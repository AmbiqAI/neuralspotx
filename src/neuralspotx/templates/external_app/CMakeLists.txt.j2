cmake_minimum_required(VERSION 3.24)
project({{ app_name }} LANGUAGES C CXX ASM)

set(NSX_BOARD "{{ board }}" CACHE STRING "Target board")

# Audited baseline: Apollo510 EVB/GCC. Re-audit external setting inputs when
# changing modules or board logic; use nsx_debug_read_text for data inputs.
include(${CMAKE_CURRENT_LIST_DIR}/cmake/nsx/nsx_debug_template.cmake)

include(${CMAKE_CURRENT_LIST_DIR}/cmake/nsx/modules.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/cmake/nsx/nsx_app_bootstrap.cmake)

nsx_bootstrap_app(
    APP_ROOT "${CMAKE_CURRENT_LIST_DIR}"
    BOARD "${NSX_BOARD}"
    MODULES ${NSX_APP_MODULES}
)

add_executable({{ app_name }}
    src/main.c
)

target_link_libraries({{ app_name }} PRIVATE
    nsx::board
)
if(NOT NSX_SDK_PROVIDER STREQUAL "corstone")
    target_link_libraries({{ app_name }} PRIVATE nsx::runtime_core)
endif()

nsx_finalize_app({{ app_name }})
if(NSX_DEBUG_CONTEXT)
    nsx_debug_set_primary_target({{ app_name }})
endif()
