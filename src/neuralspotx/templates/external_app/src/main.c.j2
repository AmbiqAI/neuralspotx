#if defined(NSX_PLATFORM_CORSTONE)
#include <stdio.h>
#include "uart_stdout.h"

int main(void)
{
    UartStdOutInit();
    puts("nsx hello from generated app");
    return 0;
}
#else
#include "nsx_core.h"
#include "nsx_mem.h"

int main(void)
{
    nsx_core_config_t cfg = {
        .api = &nsx_core_V1_0_0,
    };
    if (nsx_core_init(&cfg) != NSX_STATUS_SUCCESS) {
        nsx_core_fail_loop();
    }
#if defined(AM_PART_APOLLO4P) || defined(AM_PART_APOLLO4L)
    /* Enable instruction and data caching for accesses to MRAM. */
    if (nsx_cache_enable() != NSX_STATUS_SUCCESS) {
        nsx_core_fail_loop();
    }
#endif

    nsx_itm_printf_enable();

    while (1) {
        nsx_printf("nsx hello from generated app\r\n");
        nsx_delay_us(1000000);
    }
}
#endif
