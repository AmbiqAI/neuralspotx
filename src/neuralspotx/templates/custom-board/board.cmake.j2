# Custom board: silicon wiring comes from the SDK; board wiring is local.
nsx_module_dir_for_name(_core_dir "nsx-core")
get_filename_component(_sdk_root "${NSX_ROOT}/${_core_dir}/../.." ABSOLUTE)
set(_app_root "${NSX_ROOT}")
set(_app_cmake_dir "${NSX_CMAKE_DIR}")
set(NSX_ROOT "${_sdk_root}")
set(NSX_CMAKE_DIR "${_sdk_root}/cmake")
include("${NSX_CMAKE_DIR}/socs/${NSX_RESOLVED_BOARD_SOC}.cmake")
set(NSX_ROOT "${_app_root}")
set(NSX_CMAKE_DIR "${_app_cmake_dir}")

set(NSX_BOARD_TARGET nsx_board_{{ name }})
set(NSX_BOARD_FLAGS_TARGET nsx_board_{{ name }}_flags)
add_library(${NSX_BOARD_TARGET} INTERFACE)
add_library(${NSX_BOARD_FLAGS_TARGET} INTERFACE)
add_library(nsx::board ALIAS ${NSX_BOARD_TARGET})
add_library(nsx::board_{{ name }} ALIAS ${NSX_BOARD_TARGET})
add_library(nsx::board_flags ALIAS ${NSX_BOARD_FLAGS_TARGET})
target_link_libraries(${NSX_BOARD_FLAGS_TARGET} INTERFACE nsx::soc_flags)
target_link_libraries(${NSX_BOARD_TARGET} INTERFACE ${NSX_BOARD_FLAGS_TARGET})
# Add package/pin definitions only after checking your board's hardware.
include("${CMAKE_CURRENT_LIST_DIR}/flags.cmake" OPTIONAL)
include("${CMAKE_CURRENT_LIST_DIR}/memory.cmake" OPTIONAL)
# No inherited EVB probe identity. Author debug.cmake before flashing.
set(NSX_SEGGER_DEVICE "")
include("${CMAKE_CURRENT_LIST_DIR}/debug.cmake" OPTIONAL)
install(TARGETS ${NSX_BOARD_TARGET} ${NSX_BOARD_FLAGS_TARGET} EXPORT nsxTargets)
