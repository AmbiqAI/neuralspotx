#include "nsx_core.h"
#include "nsx_mem.h"
#include "am_bsp.h"
#include "am_devices_led.h"

#if !defined(AM_BSP_NUM_LEDS) || AM_BSP_NUM_LEDS < 1
#error "Blinky requires a BSP LED table; use --template default for boards without LEDs."
#else

int main(void)
{
    nsx_core_config_t cfg = {
        .api = &nsx_core_V1_0_0,
    };
    if (nsx_core_init(&cfg) != NSX_STATUS_SUCCESS) {
        nsx_core_fail_loop();
    }
#if defined(AM_PART_APOLLO4P) || defined(AM_PART_APOLLO4L)
    /* Enable instruction and data caching for accesses to MRAM. */
    if (nsx_cache_enable() != NSX_STATUS_SUCCESS) {
        nsx_core_fail_loop();
    }
#endif

    /* Use the BSP pin, polarity and drive mode for its first LED only. */
    am_devices_led_init(&am_bsp_psLEDs[0]);
    am_devices_led_off(am_bsp_psLEDs, 0);

    while (1) {
        am_devices_led_toggle(am_bsp_psLEDs, 0);
        nsx_delay_us(500000);
    }
}

#endif
